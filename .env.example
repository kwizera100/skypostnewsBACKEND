# Environment variables for IREMEE Backend
# Copy this file to .env and fill in the values

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL database for production (Vercel/Render/Railway)
DATABASE_URL="postgresql://user:password@host:5432/database"

# ─── Authentication ──────────────────────────────────────────────────────────
# Strong random secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="change_this_to_a_very_long_random_secret_string"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://your-frontend-domain.vercel.app
