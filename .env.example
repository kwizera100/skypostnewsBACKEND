# Environment variables for Sky Post News Backend
# Copy this file to .env and fill in the values

# ─── Database ──────────────────────────────────────────────────────────
# PostgreSQL database for production (Vercel/Render/Railway)
DATABASE_URL="postgresql://user:password@host:5432/database"

# ─── Authentication ────────────────────────────────────────────────────────
# Strong random secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="your_very_long_random_secret_key_here_change_this_in_production"

# ─── Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ───────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Frontend URL ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
